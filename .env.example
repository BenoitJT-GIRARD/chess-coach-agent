# Chess Coach — environment configuration template.
# Copy this file to `.env` and fill in the secrets. `.env` is gitignored.

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Lichess Opening Explorer ---
# The Explorer requires an authenticated request. Create a personal token
# (no scope to tick) at https://lichess.org/account/oauth/token/create.
# Without one the agent falls back to the bundled local opening book.
LICHESS_EXPLORER_BASE=https://explorer.lichess.ovh
LICHESS_API_BASE=https://lichess.org
LICHESS_TOKEN=
# "masters" = over-the-board master games (the reference games).
LICHESS_DATABASE=masters
LICHESS_REFERENCE_GAMES=3
# Below this number of master games a position is treated as out of theory,
# and the agent calls Stockfish instead.
THEORY_MIN_GAMES=1000

# --- Stockfish engine ---
# Inside Docker the binary is installed system-wide at /usr/games/stockfish.
STOCKFISH_PATH=/usr/games/stockfish
STOCKFISH_DEPTH=15
STOCKFISH_THREADS=1

# --- YouTube Data API v3 ---
# Create a key at https://console.cloud.google.com/ (YouTube Data API v3).
YOUTUBE_API_KEY=replace-me-with-your-youtube-data-api-key

# --- Milvus vector database ---
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_COLLECTION=chess_openings

# --- Knowledge base ---
# Two folders of Markdown articles, relative to the backend working directory.
WIKICHESS_DIR=data/wikichess
OPENINGS_DIR=data/openings

# --- Embedding model (sentence-transformers) ---
# Multilingual: the Wikichess articles are in English and the complementary
# notes in French. Qwen3-Embedding-0.6B is the heavier alternative if retrieval
# quality ever matters more than image size.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

# --- MongoDB ---
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB=chess_coach

# --- Language model that writes the agent's recommendation ---
# Any OpenAI-compatible endpoint works. When LLM_ENABLED=false, or when the
# call fails, the agent falls back on a deterministic French template.
LLM_ENABLED=true
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-me-with-your-openai-api-key
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=30
