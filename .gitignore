# --- Python ---
# The packaging folders are anchored at the root of the repository: without the
# leading slash, "lib/" or "build/" would also hide source code that happens to
# live in a folder of that name.
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
/build/
/develop-eggs/
/dist/
/downloads/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
/share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Environments ---
.venv/
venv/
env/
ENV/
.env
.envrc

# --- uv ---
.uv/

# --- Node / Angular ---
node_modules/
frontend/dist/
frontend/.angular/
frontend/.angular/cache/
npm-debug.log*

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Jupyter ---
.ipynb_checkpoints/
*-checkpoint.ipynb

# --- Testing / Linting ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.bandit

# --- Logs / runtime ---
logs/
*.log

# --- Docker / data volumes (named volumes only, never committed) ---
volumes/

# --- Trained models and artefacts ---
# Anchored: frontend/src/app/models/ holds code, not model weights.
/models/
*.tar.gz
*.pkl
*.npy

# --- OS / temp ---
*.tmp
*.bak
*.orig
*.rej

# --- Project-specific ---
infos/
data/raw/

# The Wikichess corpus. FICGS keeps every right on the text of its site, so the
# articles are not redistributed here: only the manifest that lists them is, and
# scripts/fetch_wikichess.py downloads them again into this folder.
backend/data/wikichess/*.md
