# Line endings are LF everywhere except for Windows scripts. Half of this repository is
# a Node project, and a checkout that flips its endings breaks the lockfile diff.
* text=auto eol=lf

*.py text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.html text eol=lf
*.scss text eol=lf
*.conf text eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Notebooks are JSON: treated as text, without an aggressive end-of-line rewrite.
*.ipynb text eol=lf merge=union

# Binaries.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.svg text eol=lf
