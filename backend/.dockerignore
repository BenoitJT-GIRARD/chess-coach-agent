# Keep the build context small and reproducible.
.venv/
venv/
**/__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage*
logs/
*.log

# Everything a run leaves behind, the downloaded corpus included. The Wikichess articles
# are not redistributed: `scripts/fetch_wikichess.py` downloads them and docker-compose
# mounts the folder at ingestion time. Without this line a `docker build` pulls them into
# the image whether or not .gitignore tracks them.
var/

# What the repository publishes and the image has no use for. `reports/` is not here: the
# image needs one file from it, the corpus manifest, and the Dockerfile copies that file
# alone.
notebooks/
tests/
